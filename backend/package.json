{
  "name": "school-admission-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend API for the School Admission and Parent Communication Management System",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:create": "node src/db/create-database.js",
    "db:migrate": "node src/db/migrate.js",
    "db:setup": "npm run db:create && npm run db:migrate",
    "admin:create": "node src/db/create-headteacher.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.1",
    "pg": "^8.23.1"
  }
}
